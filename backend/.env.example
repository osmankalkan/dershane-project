# ─────────────────────────────────────────────────────────────────────────────
# backend/.env.example — Sadece backend servisine özel değişkenler
# Kök dizindeki .env.example'dan kopyalanarak doldurulur.
# ─────────────────────────────────────────────────────────────────────────────


# ── Veritabanı ───────────────────────────────────────────────────────────────
# Docker Compose içinden çalışırken host = "db" (servis adı)
# Local'de (compose dışı) çalışırken host = "localhost"
DATABASE_URL=postgresql+asyncpg://dershane_user:change_this_password@localhost:5432/dershane_db


# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0


# ── Güvenlik ─────────────────────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_random_secret_key_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=60


# ── Dosya yükleme ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads/raw
