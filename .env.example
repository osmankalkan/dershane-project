# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Docker Compose + Backend için environment değişkenleri
# Kullanım: cp .env.example .env  →  değerleri düzenle  →  docker compose up
# UYARI: .env dosyasını asla Git'e push etme!
# ─────────────────────────────────────────────────────────────────────────────


# ── PostgreSQL (Docker Compose tarafından okunur) ────────────────────────────
POSTGRES_USER=dershane_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=dershane_db


# ── Backend — Veritabanı bağlantısı ─────────────────────────────────────────
# Docker Compose içinden: host = servis adı (db)
# Dışarıdan bağlanırken: host = localhost
DATABASE_URL=postgresql+asyncpg://dershane_user:change_this_password@localhost:5432/dershane_db


# ── Backend — Redis / Celery ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0


# ── Backend — Güvenlik ───────────────────────────────────────────────────────
# Üretim için rastgele bir değer üret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_secret_key_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=60


# ── Backend — Dosya yükleme ──────────────────────────────────────────────────
UPLOAD_DIR=./uploads/raw
