# ─────────────────────────────────────────────────────────────────────────────
# .gitattributes — Satır sonu tutarlılığı
# Tüm text dosyaları repository'de LF olarak saklanır.
# Windows'ta checkout sırasında da LF korunur (core.autocrlf'i override eder).
# ─────────────────────────────────────────────────────────────────────────────

# Varsayılan: tüm text dosyalarına LF zorla
* text=auto eol=lf

# ── Kesinlikle text olan uzantılar ───────────────────────────────────────────
*.py        text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
*.env       text eol=lf
*.env.*     text eol=lf
*.txt       text eol=lf
*.rst       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.sql       text eol=lf
*.sh        text eol=lf
*.mako      text eol=lf
Dockerfile  text eol=lf
*.gitignore text eol=lf

# ── Binary dosyalar — satır sonu dönüşümü yapma ───────────────────────────────
*.pdf       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.eot       binary
*.zip       binary
*.gz        binary
*.tar       binary
